#!/usr/bin/env groovy

def checkoutHadoop() {
    checkout scm
}

def writeMavenSettings() {
    withVault(
        vaultSecrets: [[
            path: 'secret/datalake/private/hadoop/hadoop-dremio-deploy-new',
            secretValues: [
                [envVar: 'NEXUS_USERNAME', vaultKey: 'nexus-username'],
                [envVar: 'NEXUS_PASSWORD', vaultKey: 'nexus-password']
            ]
        ]]
    ) {
        writeFile file: 'settings.xml', text: """\
            <settings>
              <servers>
                <server>
                  <id>dremio.nexus</id>
                  <username>${env.NEXUS_USERNAME}</username>
                  <password>${env.NEXUS_PASSWORD}</password>
                </server>
              </servers>
            </settings>
        """.stripIndent()
    }
}

def buildAndDeployNative(String classifier, boolean deployMavenArtifacts) {
    checkoutHadoop()
    writeMavenSettings()

    def mavenGoal = deployMavenArtifacts ? 'deploy' : 'package'
    def deployRepository = deployMavenArtifacts ?
        "-DaltDeploymentRepository=dremio.nexus::default::${env.NEXUS_REPO_URL}" :
        ''
    def nativeJar = "hadoop-common-native-${env.DREMIO_VERSION}-${classifier}.jar"

    sh """
        export MAVEN_CONFIG=''

        uname -m
        java -version
        mvn -version
        cmake --version
        protoc --version

        mvn -B versions:set versions:set-property \\
            -Dproperty=hadoop.version \\
            -DnewVersion=${env.DREMIO_VERSION}

        mvn -B -s settings.xml clean ${mavenGoal} \\
            -Pnative \\
            -Drequire.snappy \\
            -Drequire.openssl \\
            -Drequire.fuse \\
            -Pdist \\
            -Dtar \\
            -DskipTests \\
            ${deployRepository}

        cp hadoop-dist/target/hadoop-${env.DREMIO_VERSION}/lib/native/libhadoop.so.* libhadoop.so
        jar cvf ${nativeJar} libhadoop.so

        mvn -B -N -s settings.xml deploy:deploy-file \\
            -Durl=${env.NEXUS_REPO_URL} \\
            -DrepositoryId=dremio.nexus \\
            -Dfile=${nativeJar} \\
            -DgroupId=org.apache.hadoop \\
            -DartifactId=hadoop-common-native \\
            -Dversion=${env.DREMIO_VERSION} \\
            -Dclassifier=${classifier} \\
            -Dpackaging=jar
    """
}

pipeline {
    agent none

    environment {
        NEXUS_REPO_URL = 'https://repository.drem.io/content/repositories/releases/'
    }

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 2, unit: 'HOURS')
    }

    stages {
        stage('Compute Version') {
            agent {
                kubernetes {
                    agentInjection true
                    defaultContainer 'agent'
                    cloud 'kubernetes'
                    yamlFile 'dev-support/arm-x86-build/jenkins-evo/agent-amd64.yaml'
                }
            }

            steps {
                script {
                    def scmVars = checkoutHadoop()
                    env.HADOOP_COMMIT = scmVars.GIT_COMMIT
                    env.BUILD_TIMESTAMP = new Date().format('yyyyMMddHHmmssSSSS')
                    env.PROJECT_VERSION = sh(
                        script: '''
                            export MAVEN_CONFIG=''
                            mvn -B -q -Dexec.executable='echo' -Dexec.args='${project.version}' --non-recursive org.codehaus.mojo:exec-maven-plugin:1.3.1:exec
                        ''',
                        returnStdout: true
                    ).trim()

                    def baseVersion = env.PROJECT_VERSION.replaceFirst(/-SNAPSHOT$/, '')
                    env.DREMIO_VERSION = "${baseVersion}-dremio-${env.BUILD_TIMESTAMP}-${env.HADOOP_COMMIT.take(8)}"
                    currentBuild.displayName = "#${currentBuild.id} - ${env.DREMIO_VERSION}"
                    currentBuild.description = "${env.GIT_BRANCH}: ${env.DREMIO_VERSION}"
                }
            }
        }

        stage('Build Native Artifacts') {
            parallel {
                stage('x86') {
                    agent {
                        kubernetes {
                            agentInjection true
                            defaultContainer 'agent'
                            cloud 'kubernetes'
                            yamlFile 'dev-support/arm-x86-build/jenkins-evo/agent-amd64.yaml'
                        }
                    }
                    steps {
                        script {
                            buildAndDeployNative('linux', true)
                        }
                    }
                }

                stage('ARM') {
                    agent {
                        kubernetes {
                            agentInjection true
                            defaultContainer 'agent'
                            cloud 'kubernetes'
                            yamlFile 'dev-support/arm-x86-build/jenkins-evo/agent-arm64.yaml'
                        }
                    }
                    steps {
                        script {
                            buildAndDeployNative('linux-aarch64', false)
                        }
                    }
                }
            }
        }
    }
}
