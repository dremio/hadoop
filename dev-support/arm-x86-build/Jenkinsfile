#!/usr/bin/env groovy

/*
 * Hadoop Fork Deploy Pipeline (x86 + ARM)
 *
 * Publishes Hadoop artifacts + native libraries to Dremio's Nexus repository.
 * Uses DinD (Docker-in-Docker) sidecar to build inside the Hadoop Docker image,
 * since Jenkins agents don't have a Docker daemon.
 */

import hudson.model.*

def jenkinsAgentImage = 'us-west1-docker.pkg.dev/dremio-1093/jenkins/jenkins-agent:v43'

def PROJECT_VERSION
def VERSION
def MVN_SET_VERSION_CMD
def MVN_DEPLOY_CMD
def LIBHADOOP_SO_COPY_CMD

def NEXUS_URL = 'https://repository.drem.io/content/repositories/releases/'
def NEXUS_REPO_ID = 'dremio.nexus'

// Shared function: build Docker image, run deploy inside it, publish native JAR
def deployArchitecture(String dockerfile, String classifier, String settingsFile) {
  // Wait for DinD sidecar to generate TLS certs and become ready
  sh '''
    set -euo pipefail
    for i in $(seq 1 30); do
      if docker info >/dev/null 2>&1; then
        echo "Docker daemon ready after ${i}s"
        break
      fi
      if [ "$i" -eq 30 ]; then
        echo "Docker daemon not ready after 30s"
        exit 1
      fi
      sleep 1
    done
  '''

  sh """
    set -euo pipefail
    docker build \
      -t hadoop-build-base:latest \
      -f dev-support/docker/${dockerfile} \
      dev-support/docker/

    echo 'FROM hadoop-build-base:latest
RUN groupadd -g 1000 builder && useradd -u 1000 -g 1000 -m builder
USER builder' | docker build -t hadoop-build:latest -
  """

  sh """
    set -euo pipefail
    docker run --rm --init \
      -v "\$(pwd)":/build \
      -v "${settingsFile}":"${settingsFile}":ro \
      -w /build \
      -e MAVEN_OPTS="-Xmx4g" \
      hadoop-build:latest \
      bash -c '
        ${MVN_SET_VERSION_CMD} && \
        ${MVN_DEPLOY_CMD} --global-settings ${settingsFile} && \
        ${LIBHADOOP_SO_COPY_CMD} && \
        jar cvf hadoop-common-native-${PROJECT_VERSION}-${classifier}.jar libhadoop.so && \
        mvn -B -N deploy:deploy-file \
          --global-settings ${settingsFile} \
          -Durl=${NEXUS_URL} \
          -DrepositoryId=${NEXUS_REPO_ID} \
          -Dfile=hadoop-common-native-${PROJECT_VERSION}-${classifier}.jar \
          -DgroupId=org.apache.hadoop \
          -DartifactId=hadoop-common-native \
          -Dversion=${VERSION} \
          -Dclassifier=${classifier} \
          -Dpackaging=jar
      '
  """
}

pipeline {
  agent none

  stages {
    stage('Compute Version') {
      agent {
        label 'ci-hadoop-v3'
      }
      steps {
        script {
          checkout scm
          PROJECT_VERSION = readMavenPom().getVersion()
          VERSION = "${PROJECT_VERSION}-dremio-${BUILD_TIMESTAMP}-${GIT_COMMIT[0..7]}"
          MVN_SET_VERSION_CMD = "mvn -B versions:set versions:set-property -Dproperty=hadoop.version -DnewVersion=${VERSION}"
          MVN_DEPLOY_CMD = "mvn clean deploy -Pnative -Drequire.snappy -Drequire.openssl -Drequire.fuse -Pdist -Dtar -DskipTests -DaltDeploymentRepository=${NEXUS_REPO_ID}::default::${NEXUS_URL}"
          LIBHADOOP_SO_COPY_CMD = "cp hadoop-dist/target/hadoop-${VERSION}/lib/native/libhadoop.so.* libhadoop.so"
          echo "Publishing version: ${VERSION}"
        }
      }
    }

    stage('Build & Deploy') {
      parallel {
        stage('x86') {
          agent {
            kubernetes {
              cloud 'jenkins1'
              nodeSelector 'cloud.google.com/gke-nodepool=c4d-standard-64'
              yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: jnlp
    image: ${jenkinsAgentImage}
    resources:
      requests: { memory: 32Gi, cpu: 8 }
      limits:   { memory: 33Gi, cpu: 9 }
    env:
    - name: DOCKER_HOST
      value: tcp://localhost:2376
    - name: DOCKER_TLS_VERIFY
      value: "1"
    - name: DOCKER_CERT_PATH
      value: /certs/client
  - name: dind
    image: mirror.gcr.io/docker:28-dind
    args: ["--registry-mirror", "https://mirror.gcr.io"]
    securityContext:
      privileged: true
    volumeMounts:
    - name: certs
      mountPath: /certs
    - name: docker-storage
      mountPath: /var/lib/docker
  volumes:
  - name: certs
    emptyDir: {}
  - name: docker-storage
    emptyDir: {}
"""
            }
          }
          steps {
            script {
              checkout scm
              configFileProvider([
                configFile(
                  fileId: 'a145b4ab-11a5-47dd-b873-9fde19886a7c',
                  variable: 'MAVEN_GLOBAL_SETTINGS'
                )
              ]) {
                deployArchitecture('Dockerfile', 'linux', MAVEN_GLOBAL_SETTINGS)
              }
            }
          }
        }

        stage('ARM') {
          agent {
            kubernetes {
              cloud 'jenkins1'
              inheritFrom 'ci-hadoop-v1_central1'
              yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: jnlp
    image: ${jenkinsAgentImage}
    resources:
      requests: { memory: 32Gi, cpu: 8 }
      limits:   { memory: 33Gi, cpu: 9 }
    env:
    - name: DOCKER_HOST
      value: tcp://localhost:2376
    - name: DOCKER_TLS_VERIFY
      value: "1"
    - name: DOCKER_CERT_PATH
      value: /certs/client
  - name: dind
    image: mirror.gcr.io/docker:28-dind
    args: ["--registry-mirror", "https://mirror.gcr.io"]
    securityContext:
      privileged: true
    volumeMounts:
    - name: certs
      mountPath: /certs
    - name: docker-storage
      mountPath: /var/lib/docker
  volumes:
  - name: certs
    emptyDir: {}
  - name: docker-storage
    emptyDir: {}
"""
            }
          }
          steps {
            script {
              checkout scm
              configFileProvider([
                configFile(
                  fileId: 'a145b4ab-11a5-47dd-b873-9fde19886a7c',
                  variable: 'MAVEN_GLOBAL_SETTINGS'
                )
              ]) {
                deployArchitecture('Dockerfile_aarch64', 'linux-aarch64', MAVEN_GLOBAL_SETTINGS)
              }
            }
          }
        }
      }
    }
  }
}
