#!/usr/bin/env groovy

/*
 * Hadoop Fork Deploy Pipeline (x86 + ARM)
 *
 * Publishes Hadoop artifacts + native libraries to Dremio's Nexus repository.
 * Uses DinD (Docker-in-Docker) sidecar because the Jenkins agents lack the
 * native toolchain (GCC 9.3+, Boost 1.72, Protobuf 3.21.12, CMake 3.16+)
 * required for Hadoop 3.4.3 native builds.
 */

import hudson.model.*

def deployArch(String dockerfile, String classifier, String settingsFile) {
  def nexusUrl = 'https://repository.drem.io/content/repositories/releases/'
  def projectVersion = readMavenPom().getVersion()
  def version = "${projectVersion}-dremio-${BUILD_TIMESTAMP}-${GIT_COMMIT[0..7]}"
  echo "Publishing version: ${version} (${classifier})"

  sh '''
    for i in $(seq 1 30); do
      docker info >/dev/null 2>&1 && echo "Docker ready after ${i}s" && break
      [ "$i" -eq 30 ] && echo "Docker not ready" && exit 1
      sleep 1
    done
  '''

  sh """
    docker build -t hadoop-build:latest \
      -f dev-support/docker/${dockerfile} dev-support/docker/
  """

  sh """
    docker run --rm --init \
      -v "\$(pwd)":/build \
      -v "${settingsFile}":"${settingsFile}":ro \
      -w /build -e MAVEN_OPTS="-Xmx4g" \
      hadoop-build:latest bash -c '\
        mvn -B versions:set versions:set-property \
          -Dproperty=hadoop.version -DnewVersion=${version} && \
        mvn clean deploy -Pnative -Drequire.snappy -Drequire.openssl \
          -Drequire.fuse -Pdist -Dtar -DskipTests \
          --global-settings ${settingsFile} \
          -DaltDeploymentRepository=dremio.nexus::default::${nexusUrl} && \
        cp hadoop-dist/target/hadoop-${version}/lib/native/libhadoop.so.* libhadoop.so && \
        jar cvf hadoop-common-native-${projectVersion}-${classifier}.jar libhadoop.so && \
        mvn -B -N deploy:deploy-file \
          --global-settings ${settingsFile} \
          -Durl=${nexusUrl} -DrepositoryId=dremio.nexus \
          -Dfile=hadoop-common-native-${projectVersion}-${classifier}.jar \
          -DgroupId=org.apache.hadoop -DartifactId=hadoop-common-native \
          -Dversion=${version} -Dclassifier=${classifier} -Dpackaging=jar'
  """
}

pipeline {
  agent none
  stages {
    stage('Deploy') {
      parallel {
        stage('x86') {
          agent {
            kubernetes {
              cloud 'jenkins1'
              nodeSelector 'cloud.google.com/gke-nodepool=c4d-standard-64'
              yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: jnlp
    image: us-west1-docker.pkg.dev/dremio-1093/jenkins/jenkins-agent:v43
    resources:
      requests: { memory: 32Gi, cpu: 8 }
      limits:   { memory: 33Gi, cpu: 9 }
    env:
    - name: DOCKER_HOST
      value: tcp://localhost:2376
    - name: DOCKER_TLS_VERIFY
      value: "1"
    - name: DOCKER_CERT_PATH
      value: /certs/client
    volumeMounts:
    - name: certs
      mountPath: /certs
  - name: dind
    image: mirror.gcr.io/docker:28-dind
    args: ["--registry-mirror", "https://mirror.gcr.io"]
    securityContext:
      privileged: true
    volumeMounts:
    - name: certs
      mountPath: /certs
    - name: docker-storage
      mountPath: /var/lib/docker
  volumes:
  - name: certs
    emptyDir: {}
  - name: docker-storage
    emptyDir: {}
"""
            }
          }
          steps {
            checkout scm
            configFileProvider([configFile(fileId: 'a145b4ab-11a5-47dd-b873-9fde19886a7c', variable: 'MVN_SETTINGS')]) {
              script { deployArch('Dockerfile', 'linux', MVN_SETTINGS) }
            }
          }
        }
        stage('ARM') {
          agent {
            kubernetes {
              cloud 'jenkins1'
              inheritFrom 'ci-hadoop-v1_central1'
              yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: jnlp
    image: us-west1-docker.pkg.dev/dremio-1093/jenkins/jenkins-agent:v43
    resources:
      requests: { memory: 32Gi, cpu: 8 }
      limits:   { memory: 33Gi, cpu: 9 }
    env:
    - name: DOCKER_HOST
      value: tcp://localhost:2376
    - name: DOCKER_TLS_VERIFY
      value: "1"
    - name: DOCKER_CERT_PATH
      value: /certs/client
    volumeMounts:
    - name: certs
      mountPath: /certs
  - name: dind
    image: mirror.gcr.io/docker:28-dind
    args: ["--registry-mirror", "https://mirror.gcr.io"]
    securityContext:
      privileged: true
    volumeMounts:
    - name: certs
      mountPath: /certs
    - name: docker-storage
      mountPath: /var/lib/docker
  volumes:
  - name: certs
    emptyDir: {}
  - name: docker-storage
    emptyDir: {}
"""
            }
          }
          steps {
            checkout scm
            configFileProvider([configFile(fileId: 'a145b4ab-11a5-47dd-b873-9fde19886a7c', variable: 'MVN_SETTINGS')]) {
              script { deployArch('Dockerfile_aarch64', 'linux-aarch64', MVN_SETTINGS) }
            }
          }
        }
      }
    }
  }
}
